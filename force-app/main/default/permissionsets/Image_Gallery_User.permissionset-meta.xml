<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Image Gallery User</label>
    <description>Lets a user open the Image Gallery (Apex class access plus read access to the ContentVersion Capture Time and Geolocation fields).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>ImageGalleryController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>false</editable>
        <field>ContentVersion.Capture_Time__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>ContentVersion.Geolocation__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
